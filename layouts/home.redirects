# Netlify redirects, generated by Hugo from layouts/home.redirects.
# Keeps URLs from the old Wowchemy site (indexed by search engines) working.

# The Netlify subdomain serves the same site; send it to the real domain.
# Deploy previews use other subdomains and are not affected.
https://flaessig.netlify.app/*  https://www.flaessig.com/:splat  301!

# Portfolio cards used to have their own pages; send them to the linked target.
# Cards removed from the site are listed by hand below the generated lines.
{{- range (site.GetPage "/post-external").Pages }}
/post-external/{{ .File.ContentBaseName | urlize }}/  {{ .Params.external_link }}  301
{{- end }}
