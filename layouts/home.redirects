# Netlify redirects, generated by Hugo from layouts/home.redirects.
# Keeps URLs from the old Wowchemy site (indexed by search engines) working.

# Portfolio cards used to have their own pages; send them to the linked target.
{{- range (site.GetPage "/post-external").Pages }}
/post-external/{{ .File.ContentBaseName | urlize }}/  {{ .Params.external_link }}  301
{{- end }}
/post-external/consciousness-and-unambiguous-representations/  https://consciousness-is-unambiguous.com/  301
/post-external/hard-real-core-problems/  https://entropicbloom.com  301
/post-external/meta-problem/  https://entropicbloom.com  301
/post-external/neurons-representations-consciousness/  https://entropicbloom.com  301

# Listing, taxonomy and author pages no longer exist.
/post-external/  /  301
/publication/  /  301
/tags/  /  301
/tag/*  /  301
/categories/  /  301
/category/*  /  301
/publication_types/  /  301
/publication-type/*  /  301
/authors/  /  301
/author/*  /  301
/index.xml  /  301
/index.json  /  301
